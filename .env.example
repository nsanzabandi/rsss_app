# Copy this file to .env and fill in your real values. Never commit .env.

# Flask secret key (change this in production!)
SECRET_KEY=rsss-change-me-in-production

# App mode
DEBUG=true
PORT=8050

# Which database the app reads: local (default) or production
DATA_BACKEND=local

# Stunting source: 'column' (eTracker field) or 'computed' (WHO height-for-age)
STUNTING_SOURCE=column

# Email (SMTP) — use a Gmail App Password, not the account password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM=RSSS Stunting Reports <you@example.com>

# Local immunization_db (populated by sync/etl.py)
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=immunization_db
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=your-local-db-password

# eTracker (DHIS2) API — source for the ETL
ETRACKER_URL=https://tracker.moh.gov.rw
ETRACKER_USER=your-etracker-username
ETRACKER_PASSWORD=your-etracker-password
ETRACKER_PROGRAMME_ID=ESz6DeUp1Q9
ETRACKER_STAGE_ID=Fha6aDys556

# Production DB (only used when DATA_BACKEND=production)
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=15432
PROD_DB_NAME=metabase
PROD_DB_USER=metabase
PROD_DB_PASSWORD=your-prod-db-password

# Automatic background sync: hours between eTracker pulls (0 = disabled).
# Recommended: a real value (e.g. 6) so the dashboard doesn't rely solely on
# someone remembering to click "Start Sync" manually — 0 means NO new data
# ever reaches the app on its own.
AUTO_SYNC_HOURS=0

# Public URL of this app (used to build view-only dashboard links in emails)
APP_BASE_URL=http://localhost:8050

# ── eBuzima Nutrition Analytics (pages/ebuzima.py) ─────────────────────────
# Separate DB + ClickHouse mirror — do NOT point these at immunization_db.
# This page reads/syncs an entirely independent data source (Rwanda's
# eBuzima MoH Frappe system).
EBUZIMA_DB_DRIVER=postgresql+psycopg2
EBUZIMA_DB_HOST=
EBUZIMA_DB_PORT=5432
EBUZIMA_DB_USER=
EBUZIMA_DB_PASSWORD=
EBUZIMA_DB_NAME=

EBUZIMA_CLICKHOUSE_HOST=
EBUZIMA_CLICKHOUSE_PORT=8123
EBUZIMA_CLICKHOUSE_USER=
EBUZIMA_CLICKHOUSE_PASSWORD=
EBUZIMA_CLICKHOUSE_DB=ebuzima

EBUZIMA_API_KEY=
EBUZIMA_API_SECRET=
EBUZIMA_BASE_URL=https://ebuzima.moh.gov.rw
