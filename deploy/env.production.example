# Copy this file to /opt/rsss_app/.env on the server and fill in all values.
# NEVER commit the real .env to git.

# ── Flask ──────────────────────────────────────────────────────────────────────
# Generate a strong key:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

DEBUG=false
PORT=8050

# ── App public URL (used in report email links) ────────────────────────────────
# Include the sub-path — the app is served at /rsss_app/
APP_BASE_URL=https://YOUR_SERVER_IP_OR_DOMAIN/rsss_app     # ← change this

# ── Database backend ───────────────────────────────────────────────────────────
# 'local'      → immunization_db on localhost:5432  (populated by sync/etl.py)
# 'production' → metabase DB over SSH tunnel on 127.0.0.1:15432
DATA_BACKEND=local

# Stunting calculation: 'column' (eTracker field) or 'computed' (WHO z-score)
STUNTING_SOURCE=column

# ── Local immunization DB ──────────────────────────────────────────────────────
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=immunization_db
LOCAL_DB_USER=rsss_db_user
LOCAL_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Production DB (only when DATA_BACKEND=production) ─────────────────────────
# Requires an SSH tunnel:  ssh -L 15432:localhost:5432 user@db-server
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=15432
PROD_DB_NAME=metabase
PROD_DB_USER=metabase
PROD_DB_PASSWORD=REPLACE_WITH_PROD_DB_PASSWORD

# ── eTracker (DHIS2) API — used by sync/etl.py ────────────────────────────────
ETRACKER_URL=https://tracker.moh.gov.rw
ETRACKER_USER=REPLACE_WITH_ETRACKER_USERNAME
ETRACKER_PASSWORD=REPLACE_WITH_ETRACKER_PASSWORD
ETRACKER_PROGRAMME_ID=ESz6DeUp1Q9
ETRACKER_STAGE_ID=Fha6aDys556

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Use a Gmail App Password (not your Gmail login password).
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=REPLACE_WITH_GMAIL_ADDRESS
EMAIL_PASSWORD=REPLACE_WITH_16_CHAR_APP_PASSWORD
EMAIL_FROM=RSSS Stunting Reports <REPLACE_WITH_GMAIL_ADDRESS>

# ── Auto-sync (hours between eTracker pulls, 0 = disabled) ────────────────────
AUTO_SYNC_HOURS=6

# ── Test / dry-run email target ────────────────────────────────────────────────
TEST_EMAIL=nsanzabandidani@gmail.com
