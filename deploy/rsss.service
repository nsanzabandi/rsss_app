[Unit]
Description=RSSS – Rwanda Stunting Surveillance System (Plotly Dash / Gunicorn)
Documentation=https://github.com/your-org/rsss_app
After=network.target postgresql.service
Wants=postgresql.service

[Service]
# ── Identity ───────────────────────────────────────────────────────────────────
User=rsss
Group=rsss
WorkingDirectory=/opt/rsss_app

# ── Environment ────────────────────────────────────────────────────────────────
Environment="PATH=/opt/rsss_app/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/opt/rsss_app/.env

# ── Process ────────────────────────────────────────────────────────────────────
# -w 1    : single worker — Dash has in-process state (auto-sync thread, cache).
#           Multiple workers would spawn duplicate background jobs.
# -k gthread --threads 8 : real threads, so CPU-bound background work
#           (cache refresh, reports) doesn't freeze requests the way gevent did.
# --timeout 120 : allow slow DB queries (e.g. full-table stunting aggregation)
#           without gunicorn killing the worker.
ExecStart=/opt/rsss_app/.venv/bin/gunicorn app:server \
    --workers 1 \
    --worker-class gthread \
    --threads 8 \
    --timeout 120 \
    --bind 127.0.0.1:8050 \
    --log-level info \
    --access-logfile /opt/rsss_app/logs/access.log \
    --error-logfile /opt/rsss_app/logs/error.log

# ── Restart policy ─────────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# ── Security hardening ─────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/rsss_app/logs /opt/rsss_app/reports /opt/rsss_app/config

# ── Shutdown ───────────────────────────────────────────────────────────────────
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
